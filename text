<div class="cnc-container">
    
 <!-- Top Navigation & Controls -->
<header class="top-bar">
  <div class="title-section">
    <a routerLink="/" class="back-home">← Accueil</a>
    <h1><span class="pulse-icon">●</span> Moniteur Supérieur CNC & Analytics Production</h1>
    <p class="subtitle">Analyse temps réel des cadences, déphasages et rendements machine</p>
  </div>

  <div class="controls-section">
    <div class="title-section">
    <a routerLink="/historique-production" class="back-home">historique</a></div>
    
    <!-- Target PPM Configurator -->
    <div class="control-item">
      <label for="targetInput">Cible Nominale (PPM):</label>
      <div class="input-group">
        <input
          id="targetInput"
          type="number"
          [(ngModel)]="customTarget"
          min="0.1"
          step="0.5"
          (change)="applyTarget()"
        />
        <button class="btn-apply" type="button" (click)="applyTarget()">Valider</button>
      </div>
    </div>

    <!-- Machine Filter -->
    <div class="control-item">
      <label for="machineSelect">Filtre Machine:</label>
      <select
        id="machineSelect"
        [ngModel]="selectedMachine()"
        (ngModelChange)="onMachineSelect($event)"
      >
        <option value="ALL">Toutes les Machines</option>
        <option *ngFor="let m of cncSvc.machineNames()" [value]="m">{{ m }}</option>
      </select>
    </div>

    <button class="btn-danger" type="button" (click)="onReset()">Réinitialiser CNC</button>
  </div>
</header>
  <!-- Machine Cards Overview Grid -->
  <section class="cards-grid">
    <div
      *ngFor="let item of analyticsList()"
      class="machine-card"
      [class.active-card]="selectedMachine() === item.machine"
      (click)="onMachineSelect(item.machine)"
    >
      <div class="card-header">
        <div class="machine-id">
          <span class="icon">🤖</span>
          <h3>{{ item.machine }}</h3>
        </div>
        <span class="status-badge" [ngClass]="item.statusClass">{{ item.statusLabel }}</span>
      </div>

      <!-- Alert Banner inside Card if active -->
      <div
        *ngIf="item.dephasingAlert !== 'OK'"
        class="alert-banner"
        [class.alert-crit]="item.dephasingAlert === 'CRIT'"
        [class.alert-warn]="item.dephasingAlert === 'WARN'"
      >
        <span class="alert-icon">⚠️</span>
        <span class="alert-text">{{ item.dephasingMessage }}</span>
      </div>

      <div class="card-metrics">
        <div class="metric-main">
          <span class="label">Rendement Cadence</span>
          <div
            class="val-oee"
            [class.oee-ok]="item.rendementOEE >= 80"
            [class.oee-warn]="item.rendementOEE < 80 && item.rendementOEE >= 50"
            [class.oee-bad]="item.rendementOEE < 50"
          >
            {{ item.rendementOEE }}%
          </div>
        </div>

        <div class="metric-sub">
          <div class="sub-item">
            <span class="sub-label">Instant (PPM)</span>
            <span class="sub-val">{{ item.cadencePPM | number:'1.1-1' }}</span>
          </div>
          <div class="sub-item">
            <span class="sub-label">Moy. 5m (PPM)</span>
            <span class="sub-val">{{ item.avgPPM5 | number:'1.1-1' }}</span>
          </div>
          <div class="sub-item">
            <span class="sub-label">Compteur Total</span>
            <span class="sub-val highlight">{{ item.compteur | number }}</span>
          </div>
        </div>
      </div>
<div class="machine-target" (click)="$event.stopPropagation()">
  <span class="sub-label">Cible : {{ item.targetPPM }} PPM</span>
  <input type="number" min="0.1" step="0.05" placeholder="Cible par défaut"
         [(ngModel)]="machineTargetInputs[item.machine]"
         (keyup.enter)="applyMachineTarget(item.machine)" />
  <button type="button" class="btn-apply" (click)="applyMachineTarget(item.machine)">OK</button>
</div>
      <div class="card-footer">
        <span>Dernier signal: {{ item.lastSeen | date:'HH:mm:ss' }}</span>
        <span *ngIf="item.estimatedDowntimeMin > 0" class="downtime-text">
          Arrêt: {{ item.estimatedDowntimeMin }} min
        </span>
      </div>
    </div>
  </section>

  <!-- Detailed Analytics Section -->
   
  <section class="details-section" *ngIf="activeAnalytics() as data">
    <!-- Summary KPIs Bar -->
    <div class="kpi-row">
      
      <div class="kpi-card">
        <span class="kpi-title">Cadence Instantanée</span>
        <div class="kpi-value blue">
          {{ data.cadencePPM | number:'1.1-2' }} <small>PPM</small>
        </div>
        <span class="kpi-sub">Cible: {{ data.targetPPM }} PPM</span>
      </div>

      <div class="kpi-card">
        <span class="kpi-title">Moyenne 60 Min</span>
        <div class="kpi-value purple">
          {{ data.avgPPM60 | number:'1.1-2' }} <small>PPM</small>
        </div>
        <span class="kpi-sub">{{ data.producedLastHour }} pièces cette heure</span>
      </div>

      <div class="kpi-card">
        <span class="kpi-title">Production du Poste (00h+)</span>
        <div class="kpi-value green">
          {{ data.producedLastShift | number }} <small>pcs</small>
        </div>
        <span class="kpi-sub">Total compteur: {{ data.compteur }}</span>
      </div>

      <div class="kpi-card">
        <span class="kpi-title">Statistiques Historiques</span>
        <div class="kpi-stats">
          <div>
            <small>Max:</small>
            <strong>{{ data.bestHistoricalPPM | number:'1.1-1' }}</strong>
          </div>
          <div>
            <small>Moy:</small>
            <strong>{{ data.avgHistoricalPPM | number:'1.1-1' }}</strong>
          </div>
          <div>
            <small>Min:</small>
            <strong>{{ data.worstHistoricalPPM | number:'1.1-1' }}</strong>
          </div>
        </div>
      </div>
    </div>

    <!-- Charts Row -->
    <div class="charts-row">
      <div class="chart-box">
        <h3>📈 Graphique de Cadence en Temps Réel vs Cible (PPM)</h3>
        <div class="chart-wrapper">
          <canvas
            baseChart
            [data]="cadenceChartData()"
            [options]="cadenceChartOptions"
            [type]="cadenceChartType"
          >
          </canvas>
        </div>
      </div>

      <div class="chart-box">
        <h3>📊 Production Horaire (Pièces / Heure)</h3>
        <div class="chart-wrapper">
          <canvas
            baseChart
            [data]="hourlyChartData()"
            [options]="hourlyChartOptions"
            [type]="hourlyChartType"
          >
          </canvas>
        </div>
      </div>
    </div>

    <!-- Journal Table of Recent Events -->
    <div class="journal-box">
      <div class="journal-header">
        <h3>📋 Journal des Ticks CNC & Calcul d'Intervalle</h3>
        <span class="journal-count">{{ journalRows().length }} enregistrements</span>
      </div>

      <div class="table-wrapper">
        <table class="data-table">
          <thead>
            <tr>
              <th>Horodatage</th>
              <th>Machine</th>
              <th>Compteur Total</th>
              <th>Δ Pièces</th>
              <th>Intervalle (min)</th>
              <th>Cadence Calculée (PPM)</th>
            </tr>
          </thead>
          <tbody>
            <tr *ngFor="let row of journalRows()">
              <td>{{ row.timestamp | date:'dd/MM/yyyy HH:mm:ss' }}</td>
              <td><span class="machine-tag">{{ row.machine }}</span></td>
              <td class="num highlight">{{ row.compteur | number }}</td>

              <td class="num">
                <span *ngIf="row.delta !== null" class="delta-plus">+{{ row.delta }}</span>
                <span *ngIf="row.delta === null" class="muted">-</span>
              </td>

              <td class="num">
                <span *ngIf="row.intervalMin !== null">
                  {{ row.intervalMin | number:'1.1-1' }} min
                </span>
                <span *ngIf="row.intervalMin === null" class="muted">-</span>
              </td>

              <td class="num font-bold">
                <span
                  *ngIf="row.ppm !== null"
                    [class.text-green]="row.ppm >= row.targetPPM"
                    [class.text-warn]="row.ppm < row.targetPPM"
                >
                  {{ row.ppm | number:'1.2-2' }} PPM
                </span>
                <span *ngIf="row.ppm === null" class="muted">-</span>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</div>


