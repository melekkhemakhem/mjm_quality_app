import { Component, OnInit, inject, computed, signal, effect } from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
import { BaseChartDirective } from 'ng2-charts';
import { ChartConfiguration, ChartData, ChartType } from 'chart.js';
import { CncService, MachineAnalytics } from '../services/cnc.service';
import { RouterModule } from '@angular/router';

export interface JournalRow {
  timestamp: string | Date;
  machine: string;
  compteur: number;
  delta: number | null;
  intervalMin: number | null;
  ppm: number | null;
  /** Cible PPM de la machine concernée (pour la couleur dans le journal) */
  targetPPM: number;
}

@Component({
  selector: 'app-cnc-dashboard',
  standalone: true,
  imports: [CommonModule, FormsModule, BaseChartDirective, RouterModule],
  templateUrl: './cnc-dashboard.component.html',
  styleUrls: ['./cnc-dashboard.component.scss']
})
export class CncDashboardComponent implements OnInit {
  cncSvc = inject(CncService);

  /** Signal pour que journalRows / charts se mettent à jour au changement de filtre */
  selectedMachine = signal<string>('ALL');

  /** Cible globale (cible par défaut des machines sans cible propre) */
  customTarget = 4;

  /** Saisies de cible par machine (liées au HTML via ngModel). null/vide = cible par défaut */
  machineTargetInputs: Record<string, number | null> = {};

  private readonly palette = ['#3b82f6', '#f59e0b', '#ec4899', '#14b8a6', '#a855f7', '#ef4444'];

  constructor() {
    effect(() => {
      this.customTarget = this.cncSvc.targetPPM();
    });
  }

  ngOnInit(): void {
    this.customTarget = this.cncSvc.targetPPM();
    this.cncSvc.loadHistory(200).subscribe({
      error: (err) => console.error('Erreur chargement CNC:', err)
    });
  }

  onReset(): void {
    this.cncSvc.resetData().subscribe({
      next: () => this.onMachineSelect('ALL'),
      error: (err) => console.error('Erreur reset CNC:', err)
    });
  }

  // ---------- Analytics ----------

  /** Liste des machines (une carte par machine, détectées automatiquement) */
  analyticsList = computed(() => Array.from(this.cncSvc.analyticsMap().values()));

  /** Libellé affiché au-dessus des KPI */
  activeLabel = computed(() => {
    const sel = this.selectedMachine();
    const n = this.cncSvc.analyticsMap().size;
    return sel === 'ALL' || !this.cncSvc.analyticsMap().has(sel)
      ? `Toutes les machines (${n})`
      : sel;
  });

  /**
   * Analytics pour les KPI :
   *  - machine sélectionnée → ses propres valeurs
   *  - « Toutes les machines » → agrégat (somme des pièces et des cadences)
   */
  activeAnalytics = computed<MachineAnalytics>(() => {
    const map = this.cncSvc.analyticsMap();
    const sel = this.selectedMachine();

    if (sel !== 'ALL' && map.has(sel)) {
      return map.get(sel)!;
    }

    const values = Array.from(map.values());
    if (values.length === 0) return this.emptyAnalytics();
    if (values.length === 1) return values[0];
    return this.aggregate(values);
  });

  private emptyAnalytics(): MachineAnalytics {
    return {
      machine: 'AUCUNE',
      compteur: 0,
      lastSeen: '-',
      cadencePPM: 0,
      instantPPM: 0,
      avgPPM5: 0,
      avgPPM60: 0,
      targetPPM: this.cncSvc.targetPPM(),
      rendementOEE: 0,
      status: 'OFFLINE',
      statusClass: 'status-offline',
      statusLabel: 'AUCUNE DONNÉE',
      producedLastHour: 0,
      producedLastShift: 0,
      dephasingAlert: 'OK',
      dephasingMessage: 'Aucune machine connectée',
      estimatedDowntimeMin: 0,
      avgHistoricalPPM: 0,
      bestHistoricalPPM: 0,
      worstHistoricalPPM: 0
    };
  }

  /** Agrégat de plusieurs machines (cadences et pièces cumulées) */
  private aggregate(list: MachineAnalytics[]): MachineAnalytics {
    const sum = (f: (m: MachineAnalytics) => number) => list.reduce((a, m) => a + f(m), 0);

    const cadence = sum((m) => m.cadencePPM);
    const target = sum((m) => m.targetPPM);
    const running = list.filter((m) => m.status === 'RUNNING').length;
    const slow = list.filter((m) => m.status === 'SLOW').length;
    const n = list.length;

    let status: MachineAnalytics['status'] = 'RUNNING';
    let statusClass = 'status-running';
    if (running === 0 && slow === 0) {
      status = 'STOPPED';
      statusClass = 'status-stopped';
    } else if (running < n) {
      status = 'SLOW';
      statusClass = 'status-slow';
    }

    const crit = list.filter((m) => m.dephasingAlert === 'CRIT').length;
    const warn = list.filter((m) => m.dephasingAlert === 'WARN').length;
    const dephasingAlert: MachineAnalytics['dephasingAlert'] =
      crit > 0 ? 'CRIT' : warn > 0 ? 'WARN' : 'OK';
    const dephasingMessage =
      crit + warn > 0
        ? `${crit + warn} machine(s) en alerte sur ${n}`
        : 'Toutes les machines sont conformes';

    const lastSeen = list
      .map((m) => m.lastSeen)
      .filter((d) => d && d !== '-')
      .sort()
      .pop() ?? '-';

    return {
      machine: 'ALL',
      compteur: sum((m) => m.compteur),
      lastSeen,
      cadencePPM: cadence,
      instantPPM: cadence,
      avgPPM5: sum((m) => m.avgPPM5),
      avgPPM60: sum((m) => m.avgPPM60),
      targetPPM: target,
      rendementOEE: target > 0 ? Math.min(150, Math.round((cadence / target) * 100)) : 0,
      status,
      statusClass,
      statusLabel: `${running}/${n} EN PRODUCTION`,
      producedLastHour: sum((m) => m.producedLastHour),
      producedLastShift: sum((m) => m.producedLastShift),
      dephasingAlert,
      dephasingMessage,
      estimatedDowntimeMin: Math.max(...list.map((m) => m.estimatedDowntimeMin)),
      avgHistoricalPPM: sum((m) => m.avgHistoricalPPM),
      bestHistoricalPPM: sum((m) => m.bestHistoricalPPM),
      worstHistoricalPPM: sum((m) => m.worstHistoricalPPM)
    };
  }

  // ---------- Journal ----------

  /**
   * Lignes du journal pré-calculées côté TS
   * (interdit d'utiliser new Date() dans le template HTML Angular).
   * Le tick précédent est suivi PAR MACHINE : les ticks de machines différentes
   * ne se mélangent plus.
   */
  journalRows = computed<JournalRow[]>(() => {
    const recs = this.cncSvc.records();
    const selMach = this.selectedMachine();
    const analytics = this.cncSvc.analyticsMap();
    const globalTarget = this.cncSvc.targetPPM();

    const filtered = selMach === 'ALL' ? recs : recs.filter((r) => r.machine === selMach);

    const sorted = [...filtered].sort(
      (a, b) => new Date(a.timestamp).getTime() - new Date(b.timestamp).getTime()
    );

    const rows: JournalRow[] = [];
    const lastByMachine = new Map<string, (typeof sorted)[number]>();

    for (const curr of sorted) {
      const prev = lastByMachine.get(curr.machine) ?? null;

      let delta: number | null = null;
      let intervalMin: number | null = null;
      let ppm: number | null = null;

      if (prev) {
        delta = curr.compteur - prev.compteur;
        const dtMs = new Date(curr.timestamp).getTime() - new Date(prev.timestamp).getTime();
        if (dtMs > 0) {
          intervalMin = dtMs / 60000;
          if (delta >= 0) ppm = delta / intervalMin;
        }
      }

      rows.push({
        timestamp: curr.timestamp,
        machine: curr.machine,
        compteur: curr.compteur,
        delta,
        intervalMin,
        ppm,
        targetPPM: analytics.get(curr.machine)?.targetPPM ?? globalTarget
      });
      lastByMachine.set(curr.machine, curr);
    }

    // Plus récent en premier
    return rows.reverse();
  });

  // ---------- Graphique cadence (ligne, une courbe par machine) ----------
  cadenceChartType: ChartType = 'line';

  cadenceChartData = computed<ChartData<'line'>>(() => {
    const recs = this.cncSvc.records();
    const sel = this.selectedMachine();
    const filtered = sel === 'ALL' ? recs : recs.filter((r) => r.machine === sel);

    const sorted = [...filtered].sort(
      (a, b) => new Date(a.timestamp).getTime() - new Date(b.timestamp).getTime()
    );

    // PPM calculé par machine
    const series = new Map<string, { t: number; ppm: number }[]>();
    const last = new Map<string, (typeof sorted)[number]>();

    for (const curr of sorted) {
      const prev = last.get(curr.machine);
      last.set(curr.machine, curr);
      if (!prev) continue;

      const t = new Date(curr.timestamp).getTime();
      const dtMin = (t - new Date(prev.timestamp).getTime()) / 60000;
      const dCount = curr.compteur - prev.compteur;
      if (dtMin > 0.05 && dCount >= 0) {
        const arr = series.get(curr.machine) ?? [];
        arr.push({ t, ppm: Number((dCount / dtMin).toFixed(2)) });
        series.set(curr.machine, arr);
      }
    }

    // 30 derniers points par machine, axe X commun
    const trimmed = new Map<string, Map<number, number>>();
    const allTimes = new Set<number>();
    series.forEach((arr, m) => {
      const pts = new Map<number, number>();
      arr.slice(-30).forEach((p) => {
        pts.set(p.t, p.ppm);
        allTimes.add(p.t);
      });
      trimmed.set(m, pts);
    });
    const times = Array.from(allTimes).sort((a, b) => a - b);

    const labels = times.map((t) =>
      new Date(t).toLocaleTimeString([], {
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit'
      })
    );

    const datasets: ChartData<'line'>['datasets'] = [];
    let i = 0;
    trimmed.forEach((pts, m) => {
      const color = this.palette[i++ % this.palette.length];
      datasets.push({
        data: times.map((t) => pts.get(t) ?? null),
        label: `${m} (PPM)`,
        borderColor: color,
        backgroundColor: color + '26',
        fill: sel !== 'ALL',
        tension: 0.3,
        pointRadius: 3,
        spanGaps: true
      });
    });

    // Ligne de cible : machine sélectionnée, ou machine unique en mode « Toutes »
    const targetMachine: string | null =
      sel !== 'ALL' ? sel : trimmed.size === 1 ? Array.from(trimmed.keys())[0] : null;

    if (targetMachine) {
      const target =
        this.cncSvc.analyticsMap().get(targetMachine)?.targetPPM ?? this.cncSvc.targetPPM();
      datasets.push({
        data: times.map(() => target),
        label: 'Cible Nominale (PPM)',
        borderColor: '#10b981',
        borderDash: [6, 4],
        pointRadius: 0,
        fill: false
      });
    }

    return { labels, datasets };
  });

  cadenceChartOptions: ChartConfiguration['options'] = {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
      legend: {
        labels: { color: '#9ca3af', font: { size: 12 } }
      }
    },
    scales: {
      x: {
        ticks: { color: '#9ca3af', font: { size: 10 } },
        grid: { color: 'rgba(255,255,255,0.05)' }
      },
      y: {
        ticks: { color: '#9ca3af' },
        grid: { color: 'rgba(255,255,255,0.05)' },
        beginAtZero: true
      }
    }
  };

  // ---------- Graphique horaire (barres) ----------
  hourlyChartType: ChartType = 'bar';

  hourlyChartData = computed<ChartData<'bar'>>(() => {
    const hourlyData = this.cncSvc.hourlyProduction();
    return {
      labels: hourlyData.map((h) => h.hourLabel),
      datasets: [
        {
          data: hourlyData.map((h) => h.count),
          label: 'Pièces / Heure',
          backgroundColor: '#8b5cf6',
          borderRadius: 4
        }
      ]
    };
  });

  hourlyChartOptions: ChartConfiguration['options'] = {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
      legend: {
        labels: { color: '#9ca3af', font: { size: 12 } }
      }
    },
    scales: {
      x: {
        ticks: { color: '#9ca3af', font: { size: 10 } },
        grid: { color: 'rgba(255,255,255,0.05)' }
      },
      y: {
        ticks: { color: '#9ca3af' },
        grid: { color: 'rgba(255,255,255,0.05)' },
        beginAtZero: true
      }
    }
  };

  // ---------- Actions UI ----------
  onMachineSelect(machine: string): void {
    this.selectedMachine.set(machine);
    this.cncSvc.selectedMachine.set(machine);
  }

  /** Cible globale (par défaut) */
  applyTarget(): void {
    if (this.customTarget > 0) {
      this.cncSvc.setTargetPPM(this.customTarget);
    }
  }

  /** Cible propre à une machine (champ vide = retour à la cible par défaut) */
  applyMachineTarget(machine: string): void {
    const v = this.machineTargetInputs[machine];
    const target = v != null && v > 0 ? v : null;
    this.cncSvc.setMachineTarget(machine, target).subscribe({
      next: () => (this.machineTargetInputs[machine] = null),
      error: (err) => console.error('Erreur cible machine:', err)
    });
  }
}

