.cnc-container {
  padding: 1.5rem;
  background-color: #0b1220;
  color: #f3f4f6;
  min-height: 100vh;
  font-family: system-ui, -apple-system, sans-serif;

  .top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #111827;
    padding: 1rem 1.5rem;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    margin-bottom: 1.5rem;

    .title-section {
      h1 {
        font-size: 1.4rem;
        font-weight: 700;
        margin: 0;
        color: #f9fafb;
        display: flex;
        align-items: center;
        gap: 0.5rem;

        .pulse-icon {
          color: #10b981;
          font-size: 0.9rem;
          animation: pulse 2s infinite;
        }
      }

      .subtitle {
        font-size: 0.85rem;
        color: #9ca3af;
        margin: 0.25rem 0 0 0;
      }
    }

    .controls-section {
      display: flex;
      align-items: center;
      gap: 1.25rem;

      .control-item {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;

        label {
          font-size: 0.75rem;
          color: #9ca3af;
          text-transform: uppercase;
          letter-spacing: 0.05em;
        }

        select, input {
          background: #1f2937;
          border: 1px solid #374151;
          color: #fff;
          padding: 0.4rem 0.75rem;
          border-radius: 6px;
          font-size: 0.875rem;
          outline: none;

          &:focus {
            border-color: #3b82f6;
          }
        }

        .input-group {
          display: flex;
          gap: 0.5rem;

          input {
            width: 70px;
          }

          .btn-apply {
            background: #3b82f6;
            color: #fff;
            border: none;
            padding: 0.4rem 0.75rem;
